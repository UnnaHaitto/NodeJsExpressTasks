# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats

### get cat by user id
GET {{apiUrl}}/cats/user/43

### get cat by id
GET {{apiUrl}}/cats/46

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": "43",
    "filename": "https://placecats.com/310/240"
}

### edit existing cat
PUT {{apiUrl}}/cats/43
Content-Type: application/json

{
    "weight": 6,
    "owner": 37
}

### delete cat by id
DELETE {{apiUrl}}/cats/43

### post cat with image
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

40
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="file"; filename="images.jpeg"
Content-Type: image/jpeg

< ./images.jpeg
--MyBoundary--

#USER TESTS START HERE

### get users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/37

### add new user
POST {{apiUrl}}/users
Content-Type: application/json

{
"name": "Marjatta Mattila",
"username": "marjattaMattila",
"email": "marjattam@metropolia.fi",
"password": "password",
"role": "manager"
}

### change user details ////
PUT {{apiUrl}}/users/43
Content-Type: application/json

{
"name": "Marjatta Mikkola",
"username": "marjattamikkola",
"email": "marjattam@metropolia.fi",
"password": "password",
"role": "user"
}

### delete user by id ////
DELETE {{apiUrl}}/users/40
