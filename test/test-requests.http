# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats

### get cat by user id
GET {{apiUrl}}/cats/user/50
Authorization: Bearer {{login.response.body.token}}

### get cat by id
GET {{apiUrl}}/cats/50
Authorization: Bearer {{login.response.body.token}}

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### edit existing cat
PUT {{apiUrl}}/cats/60
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "weight": 6,
    "owner": 54
}

### delete cat by id
DELETE {{apiUrl}}/cats/59
Authorization: Bearer {{login.response.body.token}}

### post cat with image
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

53
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="file"; filename="images.jpeg"
Content-Type: image/jpeg

< ./images.jpeg
--MyBoundary--

#USER TESTS START HERE

### get users
GET {{apiUrl}}/users

### get user by id
GET {{apiUrl}}/users/50
Authorization: Bearer {{login.response.body.token}}

### add new user
POST {{apiUrl}}/users
Content-Type: application/json

{
"name": "Marjatta Mattila",
"username": "marjattaMattila",
"email": "marjattam@metropolia.fi",
"password": "password",
"role": "manager"
}

### add new admin
POST {{apiUrl}}/users
Content-Type: application/json

{
"name": "Lotta Mattila",
"username": "lottaMattila",
"email": "lottam@metropolia.fi",
"password": "password",
"role": "admin"
}

### change user details
PUT {{apiUrl}}/users/54
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
"role": "user"
}

### delete user by id
DELETE {{apiUrl}}/users/54
Authorization: Bearer {{login.response.body.token}}

### Post login user
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "marjattamikkola",
  "password": "password"
}

### Post login admin
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "lottaMattila",
  "password": "password"
}

### get my user info
GET {{apiUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}
